{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {},
  "ignorePatterns": [
    "dist/**",
    ".output/**",
    "node_modules/**",
    "**/routeTree.gen.ts",
    "**/*.md",
    ".omo/**"
  ]
}
