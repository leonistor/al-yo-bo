{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["octto"],
  "mcp": {
    "crawlberg": {
      "enabled": true,
      "type": "local",
      "command": ["crawlberg", "mcp"],
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"],
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
      "enabled": true,
    },
    // Agentation UI-annotation feedback (docs/UI-ANNOTATION-TOOLING.md).
    // The HTTP server on :4747 is started by `bun run dev` (dev:agentation);
    // this stdio entry joins that store instead of binding its own port.
    "agentation": {
      "type": "local",
      "command": [
        "node",
        "node_modules/.bin/agentation-mcp",
        "server",
        "--mcp-only",
        "--http-url",
        "http://localhost:4747",
      ],
      "enabled": true,
    },
    // Better-icons: agentic icon search (MCP + skill + CLI) over 200k+ icons
    // from 150+ Iconify collections; auto-learns project-used collections
    // (lucide-first here). CLI: `npx better-icons search <query> --prefix lucide`.
    "better-icons": {
      "type": "local",
      "command": ["npx", "-y", "better-icons"],
      "enabled": true,
    },
    // Octocode: evidence-first GitHub/npm/local code research (docs/ARCHITECTURE note).
    // GitHub token is picked up automatically from the `gh` CLI (no env needed).
    "octocode": {
      "type": "local",
      "command": ["npx", "-y", "octocode-mcp@latest"],
      "enabled": true,
      "environment": {
        "ENABLE_LOCAL": "true",
        "ENABLE_CLONE": "true",
      },
    },
  },
}
