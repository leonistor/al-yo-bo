{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["octto"],
  "mcp": {
    "crawlberg": {
      "enabled": true,
      "type": "local",
      "command": ["crawlberg", "mcp"],
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"],
    },
  },
}
