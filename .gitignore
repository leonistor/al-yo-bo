# Agent / tooling local state
.omo/*
!.omo/omo.jsonc
.codegraph
.octto
.impeccable/
.playwriter-profile/
.zed/local/

# Runtime / build artifacts
node_modules/
dist/
build/
.output/
*.tsbuildinfo
*.log

# Local SQLite database and WAL sidecars (seed with `bun run db:seed`)
data/

# Demo videos: regenerate with `bun run videos`; commit only preview.html
apps/web/public/demos/*.mp4

# Qdrant sidecar marker file (dropped in the process working directory)
.qdrant-initialized

# Secrets and local config
.env
.env.*
!/.env.example

# Local tool binaries (e.g. the trail single binary)
.tools/

# Finder (MacOS) folder config
.DS_Store

# Deepwork session state (git-local)
.slim/deepwork/

# local development notes
NOTES.md
