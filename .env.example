# Copy to .env — Bun auto-loads it for `bun run dev` and `bun run db:seed`.

# --- Seed data ---------------------------------------------------------------

# `bun run db:seed` loads the canonical octocat fixture (packages/db/seeds/)
# and wipes the workspace first — the seed IS the reset; there are no
# SEED_DATASET/SEED_ACTIVATE/DEFAULT_DATASET knobs anymore (one workspace,
# MODEL.md principle 1). Development isolation is a scratch data root:
#   DATA_DIR=/tmp/ayo-scratch bun run dev

# --- Embeddings (semantic search; optional, degrades to keyword-only) -------

# OpenRouter is a production provider (ARCHITECTURE §8): its defaults engage
# only under NODE_ENV=production (`bun run start`); development stays on the
# local Ollama path and keyword-only search.

# OPENROUTER_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Import extraction (ARCHITECTURE §7) --------------------------------------

# A `/`-containing id selects OpenRouter; any other id selects the local Ollama
# path; unset → OpenRouter default when a key is set (production only), else
# OLLAMA_CHAT_MODEL, else the deterministic parser.
# EXTRACT_MODEL=

# --- Auto-assignment threshold (classifier, §7 stage 4) -----------------------

# AUTO_ASSIGN_THRESHOLD=0.7

# --- Chat (local Ollama; off until a model is set → 503) ----------------------

# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Classifier (Ollaya sidecar) ---------------------------------------------

# OLLAYA_URL=http://127.0.0.1:11435
# OLLAYA_MODEL=laya
# OLLAYA_API_KEY=

# --- Qdrant vector sidecar ----------------------------------------------------

# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=bookmarks

# --- Page scraping -------------------------------------------------------------

# HTML_TO_MARKDOWN_BIN=html-to-markdown
# SCRAPE_TIMEOUT_MS=15000
# SCRAPE_MAX_CONTENT_CHARS=200000
# SCRAPE_MAX_ATTEMPTS=3

# --- Screenshots (ARCHITECTURE §10) ---------------------------------------------

# SCREENSHOT_WIDTH=1280
# SCREENSHOT_HEIGHT=800
# SCREENSHOT_SETTLE_MS=1500
# SCREENSHOT_TIMEOUT_MS=15000

# --- Server --------------------------------------------------------------------

# Single data root for every file artifact: SQLite, screenshots, avatars,
# Qdrant storage. Relative values anchor to the repo root; absolute values
# pass through. DB_PATH / SCREENSHOTS_DIR override the individual paths.
# DATA_DIR=data

# PORT=3000
# HOST=127.0.0.1
# DB_PATH overrides only the SQLite location (default <DATA_DIR>/bookmarks.db).
# DB_PATH=

# --- Bookmarks MCP server (ARCHITECTURE §8, mounted at /mcp) -------------------

# Optional bearer token for the loopbound MCP server; unset = loopback only
# (the adapter's localhost Host/Origin DNS-rebinding guard is always on).
# MCP_TOKEN=
