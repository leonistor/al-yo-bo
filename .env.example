# Copy to .env — Bun auto-loads it for `bun run dev` and `bun run db:seed`.

# --- Seed data ---------------------------------------------------------------

# Dataset loaded by `bun run db:seed`. Available: grimoire (synthetic demo
# fixture); leo (imported from docs/examples-mds/) is reserved, not implemented.
SEED_DATASET=grimoire

# Uncomment to wipe existing bookmarks/tags/categories before seeding.
# SEED_RESET=1

# --- Embeddings (semantic search; optional, degrades to keyword-only) -------

# OPENROUTER_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=

# --- Chat (local Ollama; off until a model is set) ---------------------------

# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Classifier (Ollaya sidecar) ---------------------------------------------

# OLLAYA_URL=http://127.0.0.1:11435
# OLLAYA_MODEL=laya
# OLLAYA_API_KEY=

# --- Qdrant vector sidecar ----------------------------------------------------

# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=bookmarks

# --- Page scraping -------------------------------------------------------------

# HTML_TO_MARKDOWN_BIN=html-to-markdown
# SCRAPE_TIMEOUT_MS=15000

# --- Server --------------------------------------------------------------------

# PORT=3000
# HOST=127.0.0.1
# DB_PATH=data/bookmarks.db
