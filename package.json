{
  "name": "al-yo-bo",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:server": "bun run --filter '@al-yo-bo/server' dev",
    "dev:web": "bun run --filter '@al-yo-bo/web' dev",
    "dev:qdrant": "if [ -x .tools/qdrant/qdrant ]; then exec bash scripts/qdrant/start.sh; else echo '[qdrant] not installed — run: bun run qdrant:install (continuing with in-memory vectors)'; fi",
    "dev:ollaya": "if [ -x .tools/ollaya/bin/ollaya ]; then exec bash scripts/ollaya/start.sh; else echo '[ollaya] not installed — run: bun run ollaya:install (continuing without classification)'; fi",
    "dev:scrape": "if [ -x .tools/scrape/venv/bin/python ]; then exec bash scripts/scrape/start.sh; else echo '[scrape] not installed — run: bun run scrape:install (continuing with plain fetch only)'; fi",
    "dev:agentation": "agentation-mcp server",
    "dev": "bash scripts/dev.sh",
    "build": "bun run --filter '@al-yo-bo/web' build",
    "start": "NODE_ENV=production bun run apps/server/src/index.ts",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "test": "bun test",
    "db:seed": "bun run packages/db/src/seed.ts",
    "qdrant:install": "bash scripts/qdrant/install.sh",
    "qdrant:start": "bash scripts/qdrant/start.sh",
    "ollaya:install": "bash scripts/ollaya/install.sh",
    "ollaya:start": "bash scripts/ollaya/start.sh",
    "scrape:install": "bash scripts/scrape/install.sh",
    "scrape:start": "bash scripts/scrape/start.sh",
    "chrome:install": "bash scripts/chrome/install.sh",
    "browser:install": "playwriter browser install",
    "browser:start": "playwriter browser start --user-data-dir ./.playwriter-profile --headed",
    "browser:start:clean": "playwriter browser start --user-data-dir \"$(mktemp -d)/profile\" --headed"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "agentation-mcp": "^1.3.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "shadcn": "^4.21.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.62",
    "uqr": "^0.1.3"
  }
}
